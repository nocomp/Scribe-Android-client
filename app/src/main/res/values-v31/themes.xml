<resources>
    <!-- Android 12+ : neutralise le logo du splash système (fond clair, icône transparente).
         Seul le splash Compose (logo + "by Hervé PELLARIN") reste visible. -->
    <style name="Theme.Scribe" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#003189</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">#F8FAFC</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#F8FAFC</item>
    </style>
</resources>
